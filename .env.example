# Resend API key used by the contact form (src/app/actions/contact.ts) to
# send submissions to admin@akrevia.in. Get one at https://resend.com/api-keys
# and verify the akrevia.in sending domain in the Resend dashboard.
# Without this set, submissions are logged to the server console instead of
# sent (a mock fallback for local development).
RESEND_API_KEY=
